@startuml
hide circle

entity ingredients {
    * id : string <<generated>>
    --
    * name : string
    * group_id : string <<FK>>
}

entity ingredient_units {
    * id : string <<generated>>
    --
    * name : string
    * position : string / 'prefix'（数字の前）または'suffix'（数字の後）
    * requires_quantity : boolean / 量を入力するかどうか
    * order : int / ソート順
    * group_id : string <<FK>>
}

entity ingredient_categories {
    * id : string <<generated>>
    --
    * name : string
    * order : int / ソート順
    * group_id : string <<FK>>
}

entity recipe_category_mappings {
    * recipe_id : string <<FK>>
    * category_id : string <<FK>>
}

entity recipes {
    * id : string <<generated>>
    --
    * name : string
    * url : string / レシピURL
    * memo : string / メモ
    * group_id : string <<FK>>
}

entity recipe_steps{
    * id : string <<generated>>
    --
    * recipe_id : string <<FK>>
    * instruction : string / 手順
    * order : int / ソート順
}

entity recipe_ingredient_mappings {
    * recipe_id : string <<FK>>
    * ingredient_id : string <<FK>>
    * category_id : string <<FK>>
    * unit_id : string <<FK>>
    * quantity : float
    * order : int / ソート順
}

entity courses {
    * id : string <<generated>>
    ---
    * name : string / 種別（主食、主菜、副菜、汁物、その他）
    * group_id : string <<FK>>
    * order : int / ソート順
}

entity recipe_categories {
    * id : string <<generated>>
    --
    * name : string
    * order : int / ソート順
    * group_id : string <<FK>>
}

entity groups {
    * id : string <<generated>>
    * group_size : number / グループに属するユーザの数
}

entity meal_plan_recipe_mappings {
    * meal_plan_id : string <<FK>>
    * recipe_id : string <<FK>>
    * course_id : string <<FK>>
}

entity meal_plans {
    * id : string <<generated>>
    ---
    * date : date
    * group_id : string <<FK>>
    * meal_type_id : string <<FK>>
}


entity meal_types {
    * id : string <<generated>>
    --
    * name : string
    * color_id : string <<FK>>
    * group_id : string <<FK>>
    * order : int / ソート順
}

entity colors {
    * id : string <<generated>>
    --
    * name : string / 色名（イエロー, オレンジ, ピンク, レッド, 
        イエローグリーン, グリーン, スカイブルー, ブルー, パープル）
    * color_code_hex: string / 色コード
    * order : int / ソート順
}

entity shopping_items {
    * id : string <<generated>>
    --
    * name : string
    * is_pinned : boolean / trueの場合、リスト上部に固定化する
    * is_checked : boolean / trueの場合、アイテムにチェックマークが付く
    * order : int / ソート順
    * group_id : string <<FK>>
    * category_id : string <<FK>>
}

entity shopping_categories {
    * id : string <<generated>>
    --
    * name : string
    * is_default : boolean / trueの場合、デフォルトカテゴリとして扱う
    * order : int / ソート順
    * group_id : string <<FK>>
}

entity shopping_tags {
    * id : string <<generated>>
    --
    * name : string
    * group_id : string <<FK>>
}

entity shopping_item_tag_mappings {
    * item_id : string <<FK>>
    * tag_id : string <<FK>>
}

entity group_user_mappings {
    * user_id : string <<FK>>
    * group_id : string <<FK>>
}

entity users {
    * id : string <<generated>>
    --
    * name : string
    * email : string
    password : string / ログイン用パスワード（ソーシャルログインでは使用しない）
    * avatar_seed : string / プロフィール画像のシード
    provider : string / プロバイダ名（例: 'google'）
    provider_id : string / ソーシャルログイン用ID
    * created_at : date
    * updated_at : date
}

entity invitation_tokens {
    * id : string <<generated>>
    --
    * inviter_id : string <<FK>>
    * token : string
    * expires_at : date
}

entity images {
    * id : string <<generated>>
    --
    * url : string / 画像URL
    * width : int / 画像の幅
    * height : int / 画像の高さ
    * created_at : timestamp
    * updated_at : timestamp
}

entity image_mappings {
    * id : string <<generated>>
    --
    * image_id : string <<FK>>
    * mappable_type : string / 関連するモデルの型（'Recipe', 'RecipeStep', 'User'など）
    * mappable_id : string / 関連するモデルのID
    * mapping_type : string / 添付タイプ（'thumbnail', 'step_image', 'avatar'など）
    * order : int / ソート順（複数画像がある場合）
}

groups ||--o{ group_user_mappings
group_user_mappings ||--|| users
users ||--o{ invitation_tokens

groups ||--o{ shopping_items
groups ||--o{ shopping_categories
groups ||--o{ shopping_tags
shopping_categories ||--o{ shopping_items
shopping_items ||--o{ shopping_item_tag_mappings
shopping_tags }o--|| shopping_item_tag_mappings

groups ||--o{ meal_types
meal_types |o--|| colors

meal_plans }o--|| groups
meal_plans }o--|| meal_types
courses }o--|| groups
recipes }o--|| groups
recipes ||--o{ meal_plan_recipe_mappings
meal_plans ||--o{ meal_plan_recipe_mappings
meal_plan_recipe_mappings }o--|| courses

groups ||--o{ recipe_categories
recipes ||--o{ recipe_category_mappings
recipe_category_mappings }o--|| recipe_categories
recipes ||--o{ recipe_steps

image_mappings }o--|| images
recipes ||--o{ image_mappings
recipe_steps ||--o{ image_mappings
image_mappings }o--|| users

ingredients }o--|| groups
ingredient_units }o--|| groups
ingredient_categories }o--|| groups
recipes ||--o{ recipe_ingredient_mappings
recipe_ingredient_mappings }o--|| ingredients
recipe_ingredient_mappings }o--|| ingredient_units
recipe_ingredient_mappings }o--|| ingredient_categories

note right of groups
  データ共有するユーザー情報を管理する。
  ユーザは１つのグループにのみ所属できる。（拡張可能性あり）
  もしくは、すでに存在しているグループに招待してもらって所属する。
end note

note left of meal_plans
  献立情報を管理する。
end note

note right of meal_types
  献立種別を管理する。（朝食、昼食、夕食など）
end note

note right of recipes
  料理情報を管理する。
end note

note bottom of recipe_steps
  料理手順を管理する。
end note

note top of courses
  料理分類を管理する。（料理カテゴリとは別物）
end note

note left of recipe_categories
  料理カテゴリを管理する。
end note

note left of invitation_tokens
  ユーザ招待トークンを管理する。
  グループに招待するときにトークンを発行する。
  一定時間でトークンは使用できなくなり、テーブルからデータを消去する。
end note

note top of image_mappings
  画像と他のテーブルとの中間テーブル。
end note

@enduml
