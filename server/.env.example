APP_NAME=meap
APP_ENV=local
APP_KEY=
# 本番: false / ローカル開発: true に変更可
APP_DEBUG=false
APP_TIMEZONE=Asia/Tokyo
APP_PORT=8000
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# 本番: warning / ローカル開発: debug に変更可
LOG_LEVEL=warning

DB_CONNECTION=pgsql
# DB_HOST=db
# DB_PORT=5432
# DB_DATABASE=laravel
# DB_USERNAME=sail
# DB_PASSWORD=password
# DB_SSLMODE=prefer
# 本番（Neon）では DB_SSLMODE=require を設定すること

SESSION_DRIVER=database
SESSION_LIFETIME=480
SANCTUM_EXPIRATION=480
# 本番: true / ローカル開発（HTTP）: false に変更可
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# キャッシュ: ローカルは database で十分。本番で Upstash（Redis）に切り替える例は下記コメント参照。
CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Upstash 等の TLS 接続で REDIS_URL を使わない場合のみ指定（例: tls）
# REDIS_SCHEME=tls
# Upstash は論理 DB が 0 のみのため、CACHE_STORE=redis のときは 0 を必ず指定する
# REDIS_CACHE_DB=0
# Upstash ダッシュボードの「Redis URL」（rediss:// で始まる）をそのまま貼ると TLS も含めて解決される
# REDIS_URL=rediss://default:UPSTASH_TOKEN@xxxx.upstash.io:6379
# CACHE_STORE=redis

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- 画像ストレージ ---
# ローカル: public（デフォルト。storage/app/public + symlink）
# staging / production: s3（Cloudflare R2）
IMAGE_DISK=public
# 署名付き URL の有効期間（分）。MasterService のキャッシュ TTL より長くすること。
IMAGE_SIGNED_URL_TTL=360

# Cloudflare R2 (S3 互換) — IMAGE_DISK=s3 のときに必要
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=meap-prod
# AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# AWS_URL=https://<r2-custom-domain>
# AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700

MEILISEARCH_NO_ANALYTICS=false

# 本番: false / ローカル開発で常時再生成したい場合: true
L5_SWAGGER_GENERATE_ALWAYS=false
# Try it out のベース URL。未設定なら servers は「/」＝Swagger を開いた同一ホストへ送る。
# （OpenAPI に絶対URLを載せたいときだけ明示する）
#L5_SWAGGER_BASE_PATH="${APP_URL}"

# Google OAuth (Laravel Socialite) — コールバックURLは Google Cloud Console にも登録する
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# --- AI ---
# Phase1 OCR プロバイダー（openai: GPT-4o Vision / google: Cloud Vision API）
AI_OCR_PROVIDER=openai
# Phase1 OpenAI OCR モデル（AI_OCR_PROVIDER=openai のときのみ使用）
AI_OCR_MODEL=gpt-4o
# Phase2 構造化プロバイダー・モデル（現時点では openai のみ）
AI_TEXT_PROVIDER=openai
AI_TEXT_MODEL=gpt-4o
# Phase2 構造化 JSON 出力の max_tokens 上限
AI_STRUCTURE_MAX_TOKENS=16384
AI_IMAGE_PROVIDER=openai
# 1分あたりの AI API 呼び出し上限（ユーザー単位）
AI_RATE_LIMIT_PER_MINUTE=3

# Google Cloud Vision API — AI_OCR_PROVIDER=google のときに必要
# https://console.cloud.google.com/ → Cloud Vision API を有効化 → API キーを発行
GOOGLE_CLOUD_VISION_API_KEY=

# OpenAI API — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=

# --- Stripe ---
STRIPE_KEY=
STRIPE_SECRET=
# 必須。未設定のままではアプリ起動時に例外となる（stripe listen の whsec_... 等を設定）
STRIPE_WEBHOOK_SECRET=

# サブスクリプション
STRIPE_PRICE_SUBSCRIPTION_STANDARD=

# 買い切りパック（one-time・失効なし）
STRIPE_PRICE_PACK_LIGHT=
STRIPE_PRICE_PACK_VALUE=

# 信頼するリバースプロキシ（カンマ区切りの IP / CIDR）。未設定時は 127.0.0.1, ::1 のみ。
# Railway 等ではリバースプロキシの IP / CIDR を確認して設定する。
# 例: remote_addr が 100.x.x.x なら TRUSTED_PROXIES=100.0.0.0/8
# TRUSTED_PROXIES=100.0.0.0/8

# --- Basic認証 ---
# 設定時のみ API 全体に Basic 認証を有効化。未設定なら無効。
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
