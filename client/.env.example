NEXT_PUBLIC_BACKEND_URL=https://localhost:8000
NEXT_PUBLIC_FRONTEND_URL=https://localhost:3000

# ステージング API の Basic 認証（SSR の apiClient 用・サーバー専用。NEXT_PUBLIC_ にはしない）
# Vercel の Environment Variables に、Railway の BASIC_AUTH_* と同じ値を設定する。
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=

# next/image の remotePatterns 用（Cloudflare R2 カスタムドメインのホスト名のみ。https:// は付けない）
# ローカル（public ディスク）では未設定でよい。Vercel の staging / production で R2 画像を使うときに設定する。
# NEXT_PUBLIC_R2_HOSTNAME=images.example.components
